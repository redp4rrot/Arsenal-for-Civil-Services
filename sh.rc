#!/usr/bin/env bash

export ARSENAL_ROOT="/var/www/Arsenal-for-Civil-Services"

# Navigate to Arsenal repo
arsenal() {
    cd "$ARSENAL_ROOT" || return 1
}

# Git add + commit
gacm() {
    if [ $# -lt 1 ]; then
        echo 'Usage: gacm "commit message"'
        return 1
    fi

    git -C "$ARSENAL_ROOT" add -A || return 1
    git -C "$ARSENAL_ROOT" commit -m "$*"
}

# Sync a Windows file or folder into the repo
throw() {
    if [ $# -ne 2 ]; then
        echo "Usage: throw 'C:\path\to\file_or_folder' 'relative/destination'"
        return 1
    fi

    local windows_path="$1"
    local relative_dest="$2"

    if ! command -v wslpath >/dev/null 2>&1; then
        echo "Error: wslpath is not available."
        return 1
    fi

    if ! command -v rsync >/dev/null 2>&1; then
        echo "Error: rsync is not installed."
        echo "Install using:"
        echo "  sudo apt install rsync"
        return 1
    fi

    local src
    src="$(wslpath -u "$windows_path")" || {
        echo "Error: Invalid Windows path."
        return 1
    }

    if [ ! -e "$src" ]; then
        echo "Error: Source not found:"
        echo "  $src"
        return 1
    fi

    local dest="$ARSENAL_ROOT/$relative_dest"
    mkdir -p "$dest" || return 1

    local name
    name="$(basename "$src")"

    if [ -d "$src" ]; then
        mkdir -p "$dest/$name" || return 1

        rsync -avh \
            "$src/" \
            "$dest/$name/" || return 1

        echo "Synced folder:"
        echo "  $name"
    else
        rsync -avh \
            "$src" \
            "$dest/" || return 1

        echo "Synced file:"
        echo "  $name"
    fi

    echo "To:"
    echo "  $dest/"
}

# Force push
gpf() {
    git -C "$ARSENAL_ROOT" push --force-with-lease "$@"
}

# Amend commit
gaca() {
    git -C "$ARSENAL_ROOT" add -A || return 1

    if [ $# -ge 1 ]; then
        git -C "$ARSENAL_ROOT" commit --amend -m "$*"
    else
        git -C "$ARSENAL_ROOT" commit --amend --no-edit
    fi
}

# Pretty git log
gl() {
    if [ $# -eq 0 ]; then
        git -C "$ARSENAL_ROOT" log --oneline --graph --decorate -n 10
    else
        git -C "$ARSENAL_ROOT" log --oneline --graph --decorate "$@"
    fi
}

# Git diff
gd() {
    if [ $# -eq 0 ]; then
        git -C "$ARSENAL_ROOT" diff HEAD
    else
        git -C "$ARSENAL_ROOT" diff "$@"
    fi
}